{
  "name": "can-ee-draws",
  "version": "2.0.0",
  "description": "A lightweight API for tracking Canada's Express Entry draw history.",
  "type": "module",
  "main": "src/worker.js",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "wrangler dev",
    "build": "rollup -c",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "validate:data": "node scripts/validate-data.js",
    "update:data": "node scripts/extractor.js",
    "check": "npm run validate:data && npm test && npm run build"
  },
  "keywords": [],
  "author": "Sagun Karanjit",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.65.0",
    "wrangler": "^4.152.0"
  }
}
